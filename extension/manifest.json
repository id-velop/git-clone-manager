{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Clone Manager",
  "version": "1.1.0",
  "description": "Clone Git repositories directly to a folder.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://gitlab.com/*",
    "https://*.gitlab.com/*",
    "https://*.gitlab.org/*",
    "https://git.example.com/*",
    "https://*.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://*.gitlab.org/*",
        "https://git.example.com/*",
        "https://*.example.com/*"
      ],
      "js": [
        "vendor/lightning-fs/lightning-fs.min.js",
        "vendor/isomorphic-git/index.umd.min.js",
        "browser-git.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
