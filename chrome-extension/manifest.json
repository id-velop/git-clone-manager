{
  "manifest_version": 3,
  "name": "Quick Clone",
  "version": "1.1.5",
  "description": "One-click git clone on GitHub, GitLab, and more. No terminal needed.",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://gitlab.com/*",
    "https://*.gitlab.com/*",
    "https://*.gitlab.org/*",
    "https://git.example.com/*",
    "https://*.example.com/*",
    "http://127.0.0.1:9456/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://*.gitlab.org/*",
        "https://git.example.com/*",
        "https://*.example.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg"
      ],
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://*.gitlab.org/*",
        "https://git.example.com/*",
        "https://*.example.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
